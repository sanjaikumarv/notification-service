# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/notifications_db

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Server Configuration
PORT=5000
WEB_URL=http://localhost:3000

# Email Configuration (SMTP)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="EC Learnix <notifications@ec-learnix.local>"

# Push Notification Configuration (FCM / Mock)
PUSH_PROVIDER=mock
# Optional FCM Configuration (if PUSH_PROVIDER=fcm)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

